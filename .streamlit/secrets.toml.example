# Get your Gemini API key from https://aistudio.google.com
GEMINI_API_KEY = "YOUR_GEMINI_API_KEY_HERE"

# Option B: Gmail (SMTP) - Recommended & Free
# Turn on 2-Step Verification on Gmail, then generate an App Password at https://myaccount.google.com/apppasswords
GMAIL_ADDRESS = "your_email@gmail.com"
GMAIL_APP_PASSWORD = "xxxx xxxx xxxx xxxx"

# Option C: Telegram Bot (Optional)
# Create a bot with @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN = "your_telegram_bot_token_here"
